# Lightsail server Postgres (customers, users, licenses, jobs)
DATABASE_URL=postgresql://smorx:PASSWORD@172.17.0.1:5432/smorx_ab

JWT_SECRET=change-me
PWD_PEPPER=change-me

# AWS S3 (actual PDF files — input + ballooned output)
# Bucket URL: https://autoballoon-storage-smorx-prod.s3.us-east-1.amazonaws.com/
# Object layout: s3://autoballoon-storage-smorx-prod/{username}/{job_id}/{filename}
# Leave AWS_S3_PREFIX empty for bucket-root storage.
# Access keys optional: leave blank on EC2 to use the instance IAM role.
# S3 is OFF unless SMORX_ALLOW_CLOUD_STORAGE=1 AND a bucket is named; there is no default bucket.
# Local-only (the default): files stay in backend/data on this machine.
SMORX_ALLOW_CLOUD_STORAGE=0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_S3_URL=
AWS_S3_PREFIX=

# Optional: hosted web app origins (comma-separated) for browser access alongside EXE
# Example: CORS_ORIGINS=https://app.smorx.ai,https://autoballoon.smorx.ai
CORS_ORIGINS=
# SMORX_OCR_FALLBACK=1
# SMORX_STRICT_DIM=1
# SMORX_FULL_EXTRACT=1       # all dimensions/text/notes/GD&T + critical/major rules
# SMORX_FULL_EXTRACT_PASSES=5
# SMORX_EXTENDED_EXTRACT=1   # GD&T FCF, surface N/Ra/Rz, drawing notes → meta + Excel sheets
# SMORX_BALLOON_GDT_SURFACE=1  # balloon GD&T + surface rows even when strict dim-only mode is on
# --- External AI (OFF by default: the app is local-only, no drawing data leaves the machine) ---
# Conversion verification always runs locally. The settings below only take effect when
# SMORX_ALLOW_EXTERNAL_AI=1; an API key on its own enables nothing.
# SMORX_ALLOW_EXTERNAL_AI=0    # 1 = allow sending data to Anthropic / OpenAI
# SMORX_EGRESS_ALLOW=          # comma-separated in-house hosts always allowed (e.g. on-prem model server)
# ANTHROPIC_API_KEY=           # AI conversion fallback (never commit real keys)
# SMORX_ANTHROPIC_CONVERT=1    # Claude DXF/STEP/SVG/PVZ → SVG → PDF when mechanical fails
# SMORX_STEP_USE_ANTHROPIC=0   # set 1 to use Claude for STEP first (skip FreeCAD)
# SMORX_ANTHROPIC_REPAIR=1     # re-build PDF with Claude if output has no selectable text
# SMORX_AI_FALLBACK=1          # AI classification of missed spans during ballooning
# OPENAI_API_KEY=sk-...
# FREECAD_CMD=FreeCADCmd       # STEP (no PMI) → DXF → PDF, local
# SMORX_PVZ_CONVERTER="\"{in}\" \"{out}\""  # external Creo View / publish CLI, local
